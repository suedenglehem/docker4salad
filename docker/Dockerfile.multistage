# Qwen3.8-27B (GGUF) served by llama.cpp on a single NVIDIA GPU (RTX 3090 / 24 GB).
#
# Multi-stage variant of Dockerfile.full. Stage 1 compiles llama.cpp in the full
# CUDA -devel image; stage 2 ships only the compiled binary plus runtime libs on
# the much smaller nvidia/cuda -runtime base. Final image ~2.6 GB instead of
# ~15.3 GB, so that's what you want to deploy on someone else's machine.
# CUDA 12.8 base; llama.cpp is built with NCCL support (-DGGML_CUDA_NCCL=ON).
#
# Build: docker build -f Dockerfile.multistage -t qwen38-llama .
# Run:   see docker-compose.yml (or ./run_27b.sh / ./run_9b.sh next to this file)

###############################################################################
# Stage 1: builder — CUDA devel toolchain + compilers; discarded after build
###############################################################################
FROM nvidia/cuda:12.8.2-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    LLAMA_CPP_DIR=/opt/llama.cpp

# Pinned to a commit known to support the Qwen3.8 (qwen3_5) hybrid architecture.
# Bump deliberately; do not track master blindly.
ENV LLAMA_CPP_COMMIT=3af988fabcf79fd81f8720505e684d2aa5bfc786

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ca-certificates \
    curl \
    libcurl4-openssl-dev \
    libncurses-dev \
    libudev-dev \
    libdrm-dev \
    && rm -rf /var/lib/apt/lists/*

# NCCL 2.26.2 (+cuda12.8) - same version as the host's /usr/local/cuda-12.8/nccl
# (see /usr/local/bin/cuda128). Extracted with dpkg -x into a folder inside the
# CUDA toolkit dir instead of being installed system-wide; ggml's FindNCCL.cmake
# honors NCCL_ROOT as a hint for both find_path(nccl.h, PATH_SUFFIXES include)
# and find_library(PATH_SUFFIXES lib lib64). The .debs ship everything under
# lib/x86_64-linux-gnu/, which find_library does NOT probe — so symlinks are
# added at the ${NCCL_ROOT}/lib/ level (without them NCCL is silently skipped:
# ggml-cuda only warns "NCCL not found" and builds without GGML_USE_NCCL).
# CPATH/LIBRARY_PATH remain as a fallback for direct compiles of <nccl.h>.
# ubuntu2204 .debs to match the jammy base.
ENV NCCL_ROOT=/usr/local/cuda/nccl

ENV CPATH=${NCCL_ROOT}/include \
    LIBRARY_PATH=${NCCL_ROOT}/lib/x86_64-linux-gnu

RUN mkdir -p /tmp/nccl-pkg && \
    curl -fsSL -o /tmp/nccl-pkg/libnccl2.deb \
        https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/x86_64/libnccl2_2.26.2-1+cuda12.8_amd64.deb && \
    curl -fsSL -o /tmp/nccl-pkg/libnccl-dev.deb \
        https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/x86_64/libnccl-dev_2.26.2-1+cuda12.8_amd64.deb && \
    dpkg -x /tmp/nccl-pkg/libnccl2.deb /tmp/nccl-pkg && \
    dpkg -x /tmp/nccl-pkg/libnccl-dev.deb /tmp/nccl-pkg && \
    mkdir -p ${NCCL_ROOT} && \
    mv /tmp/nccl-pkg/usr/* ${NCCL_ROOT}/ && \
    rm -rf /tmp/nccl-pkg && \
    ln -sf x86_64-linux-gnu/libnccl.so   ${NCCL_ROOT}/lib/libnccl.so && \
    ln -sf x86_64-linux-gnu/libnccl.so.2 ${NCCL_ROOT}/lib/libnccl.so.2 && \
    test -f ${NCCL_ROOT}/include/nccl.h && \
    test -f ${NCCL_ROOT}/lib/x86_64-linux-gnu/libnccl.so && \
    test -f ${NCCL_ROOT}/lib/libnccl.so

# Cap parallel compilation: nvcc/cicc instances are memory-hungry (~1-2 GB each)
# and -j$(nproc) can OOM a busy host mid-build. Override if you have headroom:
#   docker build --build-arg BUILD_JOBS=16 ...
ARG BUILD_JOBS=16

# CUDA 12.8 reorganized the toolkit under /usr/local/cuda-12.8/targets/... and no
# longer ships the forward-compat driver (no /usr/local/cuda/compat). The only
# libcuda.so.1 available at build time is the driver-API link stub in
# targets/x86_64-linux/lib/stubs/libcuda.so (SONAME libcuda.so.1, all cu* symbols
# defined). ggml-cuda gets a DT_NEEDED on libcuda.so.1, so executables must be able
# to resolve it at link time or they fail with "undefined reference to
# cuMemCreate/cuGetErrorString". ld searches rpath-link dirs by the exact needed
# filename (libcuda.so.1), but the stub file is named libcuda.so — hence the
# SONAME-named symlink in a dedicated dir on the rpath-link. -rpath-link is
# link-time only: at runtime the real host driver (injected by nvidia-container-
# toolkit via --gpus) is used instead.
RUN mkdir -p /usr/local/cuda/stubs && \
    ln -sf ../targets/x86_64-linux/lib/stubs/libcuda.so /usr/local/cuda/stubs/libcuda.so.1 && \
    test -f /usr/local/cuda/stubs/libcuda.so.1

RUN git clone https://github.com/ggml-org/llama.cpp.git ${LLAMA_CPP_DIR} && \
    cd ${LLAMA_CPP_DIR} && \
    git checkout --quiet ${LLAMA_CPP_COMMIT} && \
    cmake -S . -B build \
      -DGGML_CUDA=ON -DGGML_CUDA_FA_ALL_QUANTS=ON -DGGML_CUDA_NCCL=ON \
      -DCMAKE_BUILD_TYPE=Release \
      "-DCMAKE_EXE_LINKER_FLAGS=-Wl,-rpath-link,/usr/local/cuda/stubs" && \
    cmake --build build --config Release -j${BUILD_JOBS}

# nvtop — GPU/CPU/RAM monitor for `docker exec -it`. Not in Ubuntu 22.04 repos, so
# built from a pinned release tag here (stage 1 already has cmake/git/build-essential).
# NVIDIA support dlopen()s libnvml.so at runtime (host driver, injected by
# nvidia-container-toolkit) — no NVML/CUDA dev packages are needed to build it.
# libudev-dev + libdrm-dev are required because the AMD/Intel GPU backends are ON by default.
ENV NVTOP_TAG=3.3.2

RUN git clone --quiet --depth 1 --branch ${NVTOP_TAG} https://github.com/Syllo/nvtop.git /opt/nvtop && \
    cmake -S /opt/nvtop -B /opt/nvtop/build \
      -DNVIDIA_SUPPORT=ON -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /opt/nvtop/build --config Release

###############################################################################
# Stage 2: runtime — CUDA runtime libs + just enough to run llama-server and
# download the model with `hf` (draft/vision from full URLs with `wget2`) on first start
###############################################################################
FROM nvidia/cuda:12.8.2-runtime-ubuntu22.04

# Same NCCL location as stage 1 (used by the COPY below).
ENV NCCL_ROOT=/usr/local/cuda/nccl

ENV DEBIAN_FRONTEND=noninteractive \
    LLAMA_CPP_DIR=/opt/llama.cpp

# Runtime deps only (nothing from the 5 GB devel toolchain):
#   libcurl4    - llama.cpp is built with curl support (libcurl4-openssl-dev in stage 1)
#   libgomp1    - OpenMP runtime (GGML_OPENMP is ON by default in llama.cpp)
#   libstdc++6  - C++ runtime for the ggml-cuda code
#   python3/pip - provides the `hf` CLI used to download the model on first start
#   curl        - quick API checks from inside the container (e.g. curl localhost:8080/health)
#   wget2       - first-start downloads of DRAFT_MODEL_URL / VISION_MODEL_URL (full URLs; `hf` takes repo ids only)
#   openssh-client - ssh/scp/sftp out of the container
#   vim-tiny    - minimal vi editor; jammy's package ships only /usr/bin/vim.tiny, so a
#                 `vi` symlink is added explicitly below (swap for full `vim` if needed)
#   htop        - interactive process monitor
#   bmon        - network bandwidth monitor (per-interface RX/TX rates)
#   iputils-ping - ping (ICMP). Needs CAP_NET_RAW: docker run --cap-add=NET_RAW
#                 works locally, Salad workers may deny the capability
#                 ("ping: Operation not permitted") — installed for the cases
#                 where it works. scp ships with openssh-client (above).
#   net-tools   - classic network tools (ifconfig/netstat/route) for debugging container networking
#   less/nano   - pager + editor for SSH work (vi.tiny ships; `more` can't scroll back)
#   iproute2    - ss/ip (socket + route inspection; raw /proc/net/tcp is painful)
#   dnsutils    - dig/nslookup (DNS debugging)
#   jq          - JSON on the command line (API payloads, /v1/models)
#   socat       - forwards all IPv6 TCP :8888 to the llama-server on 127.0.0.1:8080 (see CMD)
#   libncurses6/libtinfo6 - runtime libs of the nvtop binary built in stage 1
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    ca-certificates \
    libcurl4 \
    libgomp1 \
    libstdc++6 \
    curl \
    wget2 \
    openssh-client \
    iputils-ping \
    vim-tiny \
    htop \
    bmon \
    net-tools \
    less \
    nano \
    iproute2 \
    dnsutils \
    jq \
    socat \
    libncurses6 \
    libtinfo6 \
    && ln -sf /usr/bin/vim.tiny /usr/local/bin/vi \
    && rm -rf /var/lib/apt/lists/*

# Pinned, verified working:
#   huggingface_hub - provides the `hf` CLI used to download the model on first start
#   fastapi/uvicorn - serve the status API on :9999 (/startup, /live, /ready — api_app.py)
#   llm             - Simon Willison's `llm` CLI; `llm.sh` uses it to chat with the local server
# Note: Ubuntu 22.04 ships pip 22 (pre-PEP 668), so --break-system-packages is NOT needed here and would actually fail
# with "no such option".
RUN python3 -m pip install --no-cache-dir \
    "huggingface_hub==1.28.0" \
    "fastapi==0.116.1" \
    "uvicorn==0.35.0" \
    "llm==0.36"

# Only the compiled binaries are needed at runtime; the ~2.4 GB source + build
# tree from stage 1 is discarded.
COPY --from=builder ${LLAMA_CPP_DIR}/build/bin/ ${LLAMA_CPP_DIR}/build/bin/
COPY --from=builder /opt/nvtop/build/src/nvtop /usr/local/bin/nvtop

# NCCL runtime lib: llama-server is built with GGML_CUDA_NCCL=ON and carries a
# hard DT_NEEDED on libnccl.so.2, which the -runtime base image does not ship.
COPY --from=builder ${NCCL_ROOT}/lib/x86_64-linux-gnu/libnccl.so* ${NCCL_ROOT}/lib/x86_64-linux-gnu/
RUN echo "${NCCL_ROOT}/lib/x86_64-linux-gnu" > /etc/ld.so.conf.d/nccl.conf && ldconfig

# Status API app, served by uvicorn on :9999 (started in the CMD below).
COPY api_app.py ${LLAMA_CPP_DIR}/api_app.py
COPY run_api.py ${LLAMA_CPP_DIR}/run_api.py
# Entrypoint script (see the CMD at the end of this file). Extracted from the
# old inline `CMD ["/bin/bash","-lc","…"]` blob: a standalone file + a plain
# 3-token exec-form CMD cannot be mis-parsed by buildkit (the inline JSON had a
# stray quote that silently fell back to shell form -> exit 2). Invoked as
# `bash /opt/llama.cpp/entry.sh`, so no exec bit is needed.
COPY entry_base.sh ${LLAMA_CPP_DIR}/entry.sh

# Permissive Jinja chat template, shipped but NOT used by default (see the
# CHAT_TEMPLATE env below): opt in by pointing CHAT_TEMPLATE at it. It accepts
# system messages anywhere in the conversation ("Jinja Exception: System
# message must be at the beginning" on strict embedded templates) and adds the
# reasoning-effort instructions + tool-calling protocol — what Claude Code's
# Anthropic-format /v1/messages requests need.
COPY qwen3.8.q6.jinja ${LLAMA_CPP_DIR}/qwen3.8.q6.jinja

# Developer helpers on PATH (/usr/local/bin precedes /usr/bin, so `uptime` below
# shadows the stock /usr/bin/uptime in every shell):
#   llm.sh      - wraps the `llm` CLI: `llm.sh [-m model]` chats with the local
#                 llama-server via `llm openai endpoint http://localhost:8080/v1`.
#   question.sh - one-shot smoke test: POSTs a fixed prompt to the local
#                 llama-server and prints the raw JSON response
#                 (`question.sh [-p port] [-m model]`).
#   uptime      - prints how long PID 1 (the container's main process) has been
#                 running, not the host kernel's uptime. `ps -p 1 -o etime=` is
#                 the elapsed time of PID 1; the trailing `=` suppresses the header.
#   version.sh  - image/build identity for a running instance: the baked-in
#                 build id (/etc/llama-image-build), the effective feature env,
#                 the sentinel-guard verdict from PID 1's cmdline, and the
#                 active downloads. Run it from an SSH session to verify which
#                 build a Salad worker is actually serving (the worker image
#                 cache can serve an older image under the same repo name).
#   stats.sh    - llama-server statistics (generation/prompt tps, queue,
#                 token totals, spec-decode) scraped from the local
#                 /metrics endpoint (llama_stats.py, also on PATH).
#                 `stats.sh --interval 2` for a live view. Aliased as
#                 `llama-stats` (symlink below) — the local-only stats command
#                 (it talks to 127.0.0.1:${PORT} and nothing else).
#   idle_watchdog.py - idle/heartbeat self-shutdown watchdog (started by the
#                 CMD below when IDLE_SHUTDOWN is armed; see its docstring and
#                 the ENV block below).
#   bw_reporter.py - HF-download bandwidth sampler (started by the entry
#                 script right before the model download; appends
#                 `epoch bytes` lines to ${API_STATE_DIR}/bw.log every 10 s
#                 for the manage_groups.py bandwidth arbitrator to read over
#                 SSH; self-exits when llama-server /health answers ok).
# SSH-presence guard (no daemon): the user touches /.ssh after logging in
#                 over SSH; idle_watchdog.py holds off its self-stop while the
#                 file exists, and the manage_groups.py bandwidth arbitrator
#                 spends no /reallocate shot. `rm /.ssh` resumes normal
#                 billing hygiene.
COPY llm.sh /usr/local/bin/llm.sh
COPY question.sh /usr/local/bin/question.sh
COPY version.sh /usr/local/bin/version.sh
COPY llama_stats.py /usr/local/bin/llama_stats.py
COPY stats.sh /usr/local/bin/stats.sh
COPY idle_watchdog.py /usr/local/bin/idle_watchdog.py
COPY bw_reporter.py /usr/local/bin/bw_reporter.py
RUN chmod +x /usr/local/bin/llm.sh /usr/local/bin/question.sh /usr/local/bin/version.sh \
    /usr/local/bin/llama_stats.py /usr/local/bin/stats.sh /usr/local/bin/idle_watchdog.py \
    /usr/local/bin/bw_reporter.py \
    && ln -sf /usr/local/bin/stats.sh /usr/local/bin/llama-stats \
    && printf '#!/bin/sh\nexec ps -p 1 -o etime=\n' > /usr/local/bin/uptime \
    && chmod +x /usr/local/bin/uptime

# Build id baked into the image at build time (read by /usr/local/bin/version.sh).
# Pass --build-arg LMSS_BUILD_ID="..." for a descriptive id; without it a UTC
# build timestamp is written, so even untagged local builds are distinguishable.
ARG LMSS_BUILD_ID
RUN { [ -n "${LMSS_BUILD_ID}" ] && printf '%s\n' "${LMSS_BUILD_ID}" || date -u +%Y-%m-%dT%H:%M:%SZ; } > /etc/llama-image-build

# Model to serve; all files are downloaded on first start if missing (CMD).
#   MODEL_*       - main model, downloaded with `hf` from the repo id (hf
#                   download takes repo ids, not full URLs). The default is
#                   the noMTP build: its MTP draft module is NOT embedded.
#                   (The non-noMTP variants, e.g. Q6_K, embed the draft.)
#   DRAFT_MODEL_URL - full URL of the MTP draft model for --spec-type
#                   draft-mtp speculative decoding; downloaded with wget2 on
#                   first start, filename taken from the URL's basename. This
#                   is the only draft source. Empty or "none" -> no draft,
#                   llama-server falls back to n-gram self-speculation.
#   VISION_MODEL_URL - full URL of the multimodal projector (mmproj) GGUF,
#                   downloaded with wget2 on first start and passed to
#                   llama-server as --mmproj (enables image input). Empty
#                   (the default) -> no vision; the projector costs ~1 GB of
#                   VRAM, so it stays off unless the card has the headroom.
#   SPEC_DRAFT_N_MAX - max speculative tokens per draft step (cloq4.sh: 5).
#
# Optional-feature values use the sentinel "none": empty or "none" means the
# feature is OFF (the CMD does nothing with that variable); any other value
# enables it. "none" (instead of just empty) exists because the SaladCloud
# API rejects empty env values (minLength 1) — a group cannot blank a
# baked-in default, but it CAN set e.g. DRAFT_MODEL_URL=none to disable the
# feature. All defaults below are "none": the image is plain out of the box,
# and a group opts in per feature — the 27B group sets DRAFT_MODEL_URL to
# the full HF URL of Qwen3.8-27B-Uncensored-draft-Q8_0.gguf.
ENV MODEL_REPO=JonathanColetti/Qwen3.8-27B-Uncensored-GGUF \
    MODEL_FILE=Qwen3.8-27B-Uncensored-noMTP-Q4_K_M.gguf \
    MODEL_DIR=/models \
    MODEL_ALIAS=qwen38-27b \
    DRAFT_MODEL_URL=none \
    DRAFT_MODEL_DIR=/models \
    VISION_MODEL_URL=none \
    VISION_MODEL_DIR=/models \
    SPEC_DRAFT_N_MAX=5

# Chat template passed to llama-server as --chat-template-file (see CMD).
# "none"/empty (the default) -> the template embedded in the GGUF is used.
# The default model (JonathanColetti/Qwen3.8-27B-Uncensored) already embeds
# the permissive template that accepts system messages anywhere in the
# conversation, so it needs no override — the custom template stays off
# unless explicitly enabled, e.g. for Claude Code against a model whose
# embedded template is strict:
#   CHAT_TEMPLATE=/opt/llama.cpp/qwen3.8.q6.jinja   (shipped by the COPY above)
ENV CHAT_TEMPLATE=none

# High-performance transfer for large model downloads (hf 1.x name; the old
# HF_HUB_ENABLE_HF_TRANSFER variable is deprecated in huggingface_hub >= 1.x).
ENV HF_XET_HIGH_PERFORMANCE=1

ENV HOST=0.0.0.0 \
    PORT=8080 \
    CTX_SIZE=131072

# Status API (uvicorn, api_app.py): /startup, /live, /ready served on this port.
ENV API_PORT=9999

# Bind address for the status API. Default 0.0.0.0 works everywhere; set "::"
# when Docker's IPv6 is enabled and you want localhost/[::1] to work too — a
# single dual-stack v6 bind also accepts IPv4, so both host stacks reach it.
ENV API_HOST=0.0.0.0

# Where the start script drops lifecycle markers that api_app.py reads
# (download_started flag) and where the background processes' logs go
# (uvicorn: api.log, socat: socat.log).
ENV API_STATE_DIR=/tmp/llama-api

# Physical GPU index llama-server runs on (host numbering, as shown by nvidia-smi).
# All cards are exposed to the container (see docker-compose.yml); this selects one.
ENV GPU_ID=0

# noMTP-Q4_K_M weights (~15.4 GB) + MTP draft (~3 GB) + 131k q8_0 KV cache
# (~4.6 GB; only 16 of the 64 layers are full-attention) come to ~23 GB: a
# comfortable fit on a 32 GB card (e.g. the RTX 5090 group) and a tight one on
# an idle 24 GB card, so offload all layers by default. Lower this (e.g. 24) if
# you share the GPU with other jobs.
ENV N_GPU_LAYERS=99

ENV THREADS=8 \
    BATCH_SIZE=256 \
    UBATCH_SIZE=256

# llama-server's auth key. Passed in from outside at runtime (the run_*.sh
# scripts export it from api.txt); empty/unset -> server runs without API-key
# auth (see the conditional flag in CMD below).
ENV API_KEY=

# Idle/heartbeat self-shutdown (idle_watchdog.py, started by the CMD below).
# Sentinel "none" (the default) = OFF: every group keeps the old behavior.
#   idle      -> kill llama-server (container exits, group stops) after
#                IDLE_TIMEOUT seconds with no chat traffic.
#   heartbeat -> same, after HEARTBEAT_TIMEOUT seconds with no client pings
#                (the cl_salad/chat_salad.sh keepalive pingers).
# The watchdog arms only after the group's /ready endpoint (api_app :9999 —
# the exact endpoint the Salad probe polls) is ok, never mid-download, and
# gives up after IDLE_GRACE seconds of never-ready; it then holds
# IDLE_ARM_GRACE seconds so the probe flips the group running before the
# countdown starts. Kill = POST the Salad group /stop endpoint (needs
# SALAD_STOP_KEY: a PER-GROUP scoped key, web-UI-created, injected by the
# deployer's --stop-key; sentinel "none" = skip) THEN SIGTERM — self-exit
# alone does NOT stop the group: Salad reschedules a new instance
# (restart_policy=never governs container restarts within an instance only).
ENV IDLE_SHUTDOWN=none \
    IDLE_TIMEOUT=600 \
    HEARTBEAT_TIMEOUT=600 \
    IDLE_GRACE=1800 \
    IDLE_ARM_GRACE=150 \
    READY_PORT=9999 \
    SALAD_STOP_KEY=none

WORKDIR ${LLAMA_CPP_DIR}

CMD ["/bin/bash", "-l", "/opt/llama.cpp/entry.sh"]
