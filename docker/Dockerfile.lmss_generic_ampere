# =============================================================================
# lmss_generic_ampere   (name spelling confirmed before push)
#
# The llamAmpere-fork variant of lmss_generic: same runtime machinery, same
# control surface, but the llama.cpp inside the image is the TurboQuant fork
# (JakeATX/llamAmpere v0.4, cloned at llama.cpp/ in the repo) instead of
# upstream, so the KV cache can run the turboN quantizations upstream does
# not have. The identity of this image IS the post.txt operating point:
# --cache-type-k turbo5 --cache-type-v turbo4 --kv-unified are baked into
# the CMD, and the MTP spec-draft vocab maps are baked at
# ${LLAMA_CPP_DIR}/mtp-vocab/.
#
# WHY THE BUILD RUNS INSIDE THE IMAGE (not an overlay of a host build):
# the host that compiles this (Ubuntu 24.04, gcc 13) produces binaries that
# need GLIBC_2.38 / GLIBCXX_3.4.32; every base in this family is ubuntu22.04
# (glibc 2.35), so a host build cannot run on any of them. Stage 1 compiles
# from source inside an ubuntu22.04 container so the glibc floor matches;
# the CUDA 13.0.2 bases match the fork's CUDA 13 build (3090 target; the
# 5090 gets the CUDA 12.8 multistage image instead).
# Rebuild rule: always build in-container like this; never COPY a host
# build/ tree from a newer distro into stage 2 here.
#
#   stage 1 (build time):  fork source + CUDA 13.0.2 devel toolchain,
#                          cmake Release, GGML_CUDA=ON, NCCL=OFF (single
#                          GPU: no libnccl.so.2 DT_NEEDED to satisfy),
#                          arches 86;89 (86 = RTX 3090 target, 89 = the
#                          4080 SUPER local smoke box)
#   stage 2 (runtime):     nvidia/cuda:13.0.2-runtime-ubuntu22.04 + the same
#                          apt/pip machinery as Dockerfile.multistage (hf CLI,
#                          socat, status API, helpers) + lmss_generic's
#                          control surface (DRAFT_MODEL/VISION_MODEL refs,
#                          SPEC_TYPE, CLAUDE_TEMPLATE, EXTRA_ARGS)
#   runtime download:      main model, + optional draft, + optional vision
#                          (same `hf` xet fast path as lmss_generic)
#
# BAKED llama-server ARGS (what makes this image different from lmss_generic):
#   --cache-type-k turbo5 --cache-type-v turbo4   (was q8_0/q8_0)
#   --kv-unified        single unified KV buffer (default on anyway at
#                       --parallel 1; explicit per post.txt)
#   --fit off           deterministic VRAM sizing, no auto-fit
#   --cache-ram 4096    max 4 GiB for the RAM prompt-cache tier (guardrail)
# Everything else (socat, run_api.py, the hf downloads, the CT/CLAUDE_TEMPLATE
# blocks, the three-way SPEC case, EXTRA_ARGS appended last) is identical to
# docker/Dockerfile.lmss_generic.
#
# PER-MODEL OPERATING POINT (no per-tuning image): the group env sets
# MODEL_REPO/MODEL_FILE/CTX_SIZE/N_GPU_LAYERS/THREADS/BATCH_SIZE/UBATCH_SIZE/
# SPEC_DRAFT_N_MAX/CLAUDE_TEMPLATE, and EXTRA_ARGS appends the rest LAST
# (llama.cpp duplicate flags = last wins). The ATX post.txt profile
# (131k ctx in 24 GB via turbo KV, tmp/post.txt) is exactly:
#   MODEL_REPO=bjivanovich/ATX-Swift-1.5-Qwen3.8-27B-Uncensored-MTP-GGUF
#   MODEL_FILE=ATX-Swift-1.5-Qwen3.8-27B-Uncensored-MTP-i1-Q5_K_M.gguf
#   VISION_MODEL=hf://bjivanovich/ATX-Swift-1.5-Qwen3.8-27B-Uncensored-MTP-GGUF/mmproj-BF16.gguf
#   CTX_SIZE=131072  N_GPU_LAYERS=99  THREADS=20  BATCH_SIZE=2048  UBATCH_SIZE=512
#   SPEC_TYPE=draft-mtp  SPEC_DRAFT_N_MAX=3  CLAUDE_TEMPLATE=1
#   EXTRA_ARGS='--threads-batch 8 --prio 3 --spec-draft-p-min 0.1 --spec-draft-type-k q8_0 --spec-draft-type-v q8_0 --spec-draft-vocab-map /opt/llama.cpp/mtp-vocab/atx_65536.txt --reasoning-format none --temp 0.2 --top-p 0.90 --top-k 40 --repeat-penalty 1.08 --repeat-last-n 256'
#   (HOST stays 0.0.0.0 for the Salad gateway, not post.txt's 127.0.0.1;
#    post.txt's GGML_Q8_TURBO3_MMA_FUSED=1 is unneeded: ON by default in
#    the fork; post.txt's --min-p 0.05 is the baked base value.)
#
# RUNPATH: stage 1 builds at /opt/llama.cpp, so the launcher's RUNPATH is the
# absolute /opt/llama.cpp/build/bin; stage 2 COPYs the binaries to the same
# path, so no patchelf is needed.
#
# BUILD (context = REPO ROOT - the fork source + docker/ helpers are COPYed;
# the root .dockerignore keeps llama.cpp/.git, llama.cpp/build and the secret
# files out of the context):
#   docker build -f docker/Dockerfile.lmss_generic_ampere \
#     -t lmss_generic_ampere:dev --build-arg BUILD_JOBS=24 .
#   (stage 1 takes ~45 min at 24 jobs)
#
# PUSH (NEW repo name = fresh Salad worker cache key; then pin the
# manifest-list digest in the deploy script for the airtight re-pull lever):
#   docker tag  lmss_generic_ampere:dev boris271142/lmss_generic_ampere:cuda130
#   docker push boris271142/lmss_generic_ampere:cuda130
# =============================================================================

###############################################################################
# Stage 1: builder - the llamAmpere fork compiled in-container on CUDA 13
###############################################################################
FROM nvidia/cuda:13.0.2-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    LLAMA_CPP_DIR=/opt/llama.cpp

# Same apt set as Dockerfile.multistage stage 1 + libssl-dev (llama.cpp links
# OpenSSL alongside libcurl; the runtime base carries libssl3).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ca-certificates \
    curl \
    libcurl4-openssl-dev \
    libncurses-dev \
    libudev-dev \
    libdrm-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# nvcc/cicc instances are memory-hungry (~1-2 GB each); 24 is the box that
# builds this. Override with --build-arg BUILD_JOBS=N.
ARG BUILD_JOBS=24

# CUDA >= 12.8 ships the toolkit under /usr/local/cuda-*/targets/... and the
# only link-time libcuda.so.1 is the driver-API stub (all cu* symbols
# defined). ggml-cuda gets a DT_NEEDED on libcuda.so.1, so executables must
# resolve it at link time or fail with "undefined reference to
# cuMemCreate/cuGetErrorString". ld searches rpath-link dirs by the exact
# needed filename, but the stub is named libcuda.so - hence the SONAME-named
# symlink in a dedicated dir on the rpath-link. -rpath-link is link-time only;
# at runtime the real host driver (injected by nvidia-container-toolkit via
# --gpus) is used instead.
RUN mkdir -p /usr/local/cuda/stubs && \
    ln -sf ../targets/x86_64-linux/lib/stubs/libcuda.so /usr/local/cuda/stubs/libcuda.so.1 && \
    test -f /usr/local/cuda/stubs/libcuda.so.1

# Fork source (llamAmpere v0.4). .git and the host build tree are excluded by
# the root .dockerignore.
COPY llama.cpp/ ${LLAMA_CPP_DIR}/

# NCCL=OFF: single-GPU image, and it drops the libnccl.so.2 DT_NEEDED that
# Dockerfile.multistage has to satisfy by hand. No FA_ALL_QUANTS: the fork's
# default fattn template set already includes the turbo (tq5_0/tq4_0)
# instances. 86 = RTX 3090 (deploy target), 89 = RTX 4080 SUPER (smoke box).
RUN cd ${LLAMA_CPP_DIR} && \
    cmake -S . -B build \
      -DGGML_CUDA=ON -DGGML_CUDA_NCCL=OFF \
      -DCMAKE_CUDA_ARCHITECTURES="86;89" \
      -DCMAKE_BUILD_TYPE=Release \
      "-DCMAKE_EXE_LINKER_FLAGS=-Wl,-rpath-link,/usr/local/cuda/stubs" && \
    cmake --build build --config Release -j${BUILD_JOBS}

# nvtop 3.3.2 - GPU/CPU/RAM monitor for docker exec (same as multistage).
# dlopen()s libnvml.so at runtime (host driver) - no extra build deps.
ENV NVTOP_TAG=3.3.2

RUN git clone --quiet --depth 1 --branch ${NVTOP_TAG} https://github.com/Syllo/nvtop.git /opt/nvtop && \
    cmake -S /opt/nvtop -B /opt/nvtop/build \
      -DNVIDIA_SUPPORT=ON -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /opt/nvtop/build --config Release

###############################################################################
# Stage 2: runtime - CUDA 13 runtime libs + just enough to run llama-server
# and download the model with `hf` on first start
###############################################################################
FROM nvidia/cuda:13.0.2-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LLAMA_CPP_DIR=/opt/llama.cpp

# Runtime deps = Dockerfile.multistage's list + libssl3 (llama-server links
# it; already on the ubuntu22.04 base, listed for explicitness).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    ca-certificates \
    libcurl4 \
    libgomp1 \
    libstdc++6 \
    curl \
    wget2 \
    openssh-client \
    vim-tiny \
    htop \
    bmon \
    net-tools \
    socat \
    libncurses6 \
    libtinfo6 \
    libssl3 \
    && ln -sf /usr/bin/vim.tiny /usr/local/bin/vi \
    && rm -rf /var/lib/apt/lists/*

# Pinned, verified working (same as the rest of the family). Ubuntu 22.04
# ships pip 22 (pre-PEP 668), so --break-system-packages is NOT needed here.
RUN python3 -m pip install --no-cache-dir \
    "huggingface_hub==1.28.0" \
    "fastapi==0.116.1" \
    "uvicorn==0.35.0" \
    "llm==0.36"

# Compiled binaries at the SAME absolute path as stage 1: the launcher's
# RUNPATH is /opt/llama.cpp/build/bin, so this is all the loader needs
# (the CUDA 13 runtime libs come from the base image itself).
COPY --from=builder ${LLAMA_CPP_DIR}/build/bin/ ${LLAMA_CPP_DIR}/build/bin/
COPY --from=builder /opt/nvtop/build/src/nvtop /usr/local/bin/nvtop

# MTP spec-draft vocab maps, referenced by --spec-draft-vocab-map (EXTRA_ARGS).
COPY llama.cpp/docs/mtp-vocab/ ${LLAMA_CPP_DIR}/mtp-vocab/

# Control surface (repo-root build context, hence the docker/ prefixes).
COPY docker/api_app.py ${LLAMA_CPP_DIR}/api_app.py
COPY docker/run_api.py ${LLAMA_CPP_DIR}/run_api.py
COPY docker/qwen3.8.q6.jinja ${LLAMA_CPP_DIR}/qwen3.8.q6.jinja
COPY docker/claude_template.sh ${LLAMA_CPP_DIR}/claude_template.sh

# Developer helpers on PATH (same set as Dockerfile.multistage).
COPY docker/llm.sh /usr/local/bin/llm.sh
COPY docker/question.sh /usr/local/bin/question.sh
COPY docker/version.sh /usr/local/bin/version.sh
COPY docker/llama_stats.py /usr/local/bin/llama_stats.py
COPY docker/stats.sh /usr/local/bin/stats.sh
COPY docker/idle_watchdog.py /usr/local/bin/idle_watchdog.py
RUN chmod +x /usr/local/bin/llm.sh /usr/local/bin/question.sh /usr/local/bin/version.sh \
    /usr/local/bin/llama_stats.py /usr/local/bin/stats.sh /usr/local/bin/idle_watchdog.py \
    && printf '#!/bin/sh\nexec ps -p 1 -o etime=\n' > /usr/local/bin/uptime \
    && chmod +x /usr/local/bin/uptime

# Build id baked into the image (read by /usr/local/bin/version.sh). The
# default lives in the RUN (shell ${ARG:-default}), NOT in the ARG line - a
# Dockerfile ARG default cannot carry unquoted spaces.
ARG LMSS_BUILD_ID
RUN printf '%s\n' "${LMSS_BUILD_ID:-lmss_generic_ampere-v2 (llamAmpere v0.4 fork, cuda 13.0.2, turbo5/turbo4 KV, idle_watchdog + PID1 supervisor) 2026-10-08}" > /etc/llama-image-build

# Model + runtime env (lmss_generic's surface). The defaults are the family's
# (JonathanColetti 27B) so a bare docker run behaves like the rest of the
# family; the ATX group overrides per the header recipe.
ENV MODEL_REPO=JonathanColetti/Qwen3.8-27B-Uncensored-GGUF \
    MODEL_FILE=Qwen3.8-27B-Uncensored-noMTP-Q4_K_M.gguf \
    MODEL_DIR=/models \
    MODEL_ALIAS=qwen38-27b \
    SPEC_DRAFT_N_MAX=5

# Optional auxiliary models: "none" (default) = off; "hf://<org>/<repo>/<file>"
# or a bare "<file>" against MODEL_REPO (downloaded at runtime with `hf`).
ENV DRAFT_MODEL=none
ENV VISION_MODEL=none
# Speculation mode: draft-mtp (default) | ngram-mod | none.
ENV SPEC_TYPE=draft-mtp
# "none" (default) -> the gguf's embedded template (or the static CHAT_TEMPLATE
# path if a group sets one); any other value -> at startup the gguf's chat
# template is dumped and the one-line Claude Code patch applied.
ENV CHAT_TEMPLATE=none
ENV CLAUDE_TEMPLATE=none
# One whitespace-separated string of extra llama-server args, appended LAST to
# the argv (llama.cpp duplicate flags = last wins). "none" (default) = off.
ENV EXTRA_ARGS=none

# High-performance transfer for large model downloads (hf 1.x name).
ENV HF_XET_HIGH_PERFORMANCE=1

ENV HOST=0.0.0.0 \
    PORT=8080 \
    CTX_SIZE=131072

# Status API (uvicorn, api_app.py): /startup, /live, /ready.
ENV API_PORT=9999
ENV API_HOST=0.0.0.0
ENV API_STATE_DIR=/tmp/llama-api

# Physical GPU index (host numbering, as shown by nvidia-smi).
ENV GPU_ID=0

# Weights + the turbo KV cache of the ATX profile fit a 24 GB card (that is
# the point of turbo5/turbo4), so offload all layers by default.
ENV N_GPU_LAYERS=99

ENV THREADS=8 \
    BATCH_SIZE=256 \
    UBATCH_SIZE=256

# llama-server's auth key, passed in from outside at runtime; empty -> no auth.
ENV API_KEY=

# Idle/heartbeat self-shutdown (idle_watchdog.py, started by the CMD below):
# "none" (default) = OFF; idle -> kill after IDLE_TIMEOUT s of no chat
# traffic; heartbeat -> kill after HEARTBEAT_TIMEOUT s of no client pings.
# Arms only after /health ok; group needs restart_policy=never (set by the
# deployers when armed) for the self-exit to stay stopped.
ENV IDLE_SHUTDOWN=none \
    IDLE_TIMEOUT=600 \
    HEARTBEAT_TIMEOUT=600 \
    IDLE_GRACE=1800

WORKDIR ${LLAMA_CPP_DIR}

# --- Runtime CMD: lmss_generic's, with the KV cache lines swapped for the
# fork's turbo quantizations plus --kv-unified --fit off --cache-ram 4096.
CMD ["/bin/bash", "-lc", "\
set -euo pipefail; \
mkdir -p \"${MODEL_DIR}\" \"${API_STATE_DIR}\"; \
nohup python3 run_api.py >>\"${API_STATE_DIR}/api.log\" 2>&1 & \
# Forward all IPv6 TCP :8888 -> 127.0.0.1:8080 (llama-server) and \
# :8889 -> 127.0.0.1:9999 (status API). TCP6-LISTEN binds [::]:<port>. \
nohup socat TCP6-LISTEN:8888,fork,reuseaddr TCP4:127.0.0.1:8080 >>\"${API_STATE_DIR}/socat.log\" 2>&1 & \
nohup socat TCP6-LISTEN:8889,fork,reuseaddr TCP4:127.0.0.1:9999 >>\"${API_STATE_DIR}/socat2.log\" 2>&1 & \
# Idle/heartbeat self-shutdown watchdog (IDLE_SHUTDOWN=none -> exits at once, \
# zero effect; see the ENV block above). Arms only after llama-server /health \
# is ok, so it never kills mid-download. \
nohup python3 /usr/local/bin/idle_watchdog.py >>\"${API_STATE_DIR}/watchdog.log\" 2>&1 & \
# Model ref resolver for the optional auxiliary models: ref \"none\"/empty -> \
# off (returns 1); \"hf://<org>/<repo>/<file>\" -> repo id <org>/<repo> + file \
# <file...> (subdirectories kept); bare \"<file...>\" -> the file in \
# MODEL_REPO. Sets the globals REPO_REF / FILE_REF; the download itself is \
# `hf` (same fast xet path + optional token as the main model). \
resolve_model_ref() { \
  ref=\"${1:-}\"; REPO_REF=\"\"; FILE_REF=\"\"; \
  case \"$ref\" in \
    \"\"|none) return 1 ;; \
    hf://*) \
      rest=\"${ref#hf://}\"; \
      REPO_REF=\"${rest%%/*}\"; \
      rest=\"${rest#*/}\"; \
      REPO_REF=\"${REPO_REF}/${rest%%/*}\"; \
      FILE_REF=\"${rest#*/}\"; \
      ;; \
    *) \
      REPO_REF=\"${MODEL_REPO}\"; FILE_REF=\"$ref\"; \
      ;; \
  esac; \
}; \
# Main model: the big runtime download (fast hf xet path). \
if [ ! -f \"${MODEL_DIR}/${MODEL_FILE}\" ]; then \
  # /startup flips to ok from here on (flag is read by api_app.py). \
  touch \"${API_STATE_DIR}/download_started\"; \
  hf download \
    \"${MODEL_REPO}\" \
    \"${MODEL_FILE}\" \
    --local-dir \"${MODEL_DIR}\" \
    ${HF_TOKEN:+--token \"$HF_TOKEN\"}; \
else \
  # Main model already present (container restart): mark started, no wait. \
  touch \"${API_STATE_DIR}/download_started\"; \
fi; \
# Optional MTP draft model: DRAFT_MODEL is \"none\" (off), \
# \"hf://<org>/<repo>/<file>\", or a bare file against MODEL_REPO. Downloaded \
# with `hf` when missing; a failed download dies loudly (set -euo pipefail). \
DRAFT_PATH=; \
if resolve_model_ref \"${DRAFT_MODEL}\"; then \
  DRAFT_PATH=\"${MODEL_DIR}/${FILE_REF}\"; \
  if [ ! -f \"${DRAFT_PATH}\" ]; then \
    hf download \"${REPO_REF}\" \"${FILE_REF}\" --local-dir \"${MODEL_DIR}\" ${HF_TOKEN:+--token \"$HF_TOKEN\"}; \
  fi; \
fi; \
# Optional multimodal projector (vision): VISION_MODEL, same ref syntax. \
VISION_PATH=; \
if resolve_model_ref \"${VISION_MODEL}\"; then \
  VISION_PATH=\"${MODEL_DIR}/${FILE_REF}\"; \
  if [ ! -f \"${VISION_PATH}\" ]; then \
    hf download \"${REPO_REF}\" \"${FILE_REF}\" --local-dir \"${MODEL_DIR}\" ${HF_TOKEN:+--token \"$HF_TOKEN\"}; \
  fi; \
fi; \
# Custom chat template: CT holds the effective path (empty when disabled). \
CT=; \
if [ -n \"${CHAT_TEMPLATE}\" ] && [ \"${CHAT_TEMPLATE}\" != \"none\" ]; then \
  CT=\"${CHAT_TEMPLATE}\"; \
fi; \
# Claude Code template: when CLAUDE_TEMPLATE is enabled (set, not \"none\"), \
# dump the chat template from the freshly downloaded gguf and apply the \
# one-line Claude patch. The script's stdout is the patched file's path and \
# OVERRIDES CT, so the single --chat-template-file flag below emits exactly \
# once. Runs AFTER the download block above (the model file must exist) and \
# re-runs cheaply on container restart (header-only scan). Non-Qwen gguf (no \
# raise-marker) -> script exits 0 with empty stdout: CT stays as the \
# CHAT_TEMPLATE block left it (embedded fallback). Hard error -> exit 1 -> \
# container dies loudly under set -euo pipefail. \
if [ -n \"${CLAUDE_TEMPLATE}\" ] && [ \"${CLAUDE_TEMPLATE}\" != \"none\" ]; then \
  CT=\"$(\"${LLAMA_CPP_DIR}/claude_template.sh\" \"${MODEL_DIR}/${MODEL_FILE}\" \"${API_STATE_DIR}/claude_chat_template.jinja\" 2>>\"${API_STATE_DIR}/claude_template.log\")\"; \
fi; \
# Speculative decoding mode (SPEC_TYPE, three-way - see the header): \
#   draft-mtp: embedded MTP head in place, or the separate draft via \
#     --model-draft when DRAFT_MODEL resolved to a file; \
#   ngram-mod: n-gram self-speculation (v3 multistage fallback params); \
#   none:     no speculative decoding. \
SPEC=; \
case \"${SPEC_TYPE}\" in \
  draft-mtp) \
    SPEC=\"--spec-type draft-mtp --spec-draft-n-max ${SPEC_DRAFT_N_MAX}\"; \
    if [ -n \"${DRAFT_PATH}\" ]; then SPEC=\"${SPEC} --model-draft ${DRAFT_PATH}\"; fi; \
    ;; \
  ngram-mod) \
    SPEC=\"--spec-type ngram-mod --spec-ngram-mod-n-match 24 --spec-ngram-mod-n-min 48 --spec-ngram-mod-n-max 64\"; \
    ;; \
  none) SPEC=; ;; \
  *) echo \"llama-image: unknown SPEC_TYPE '${SPEC_TYPE}' (want draft-mtp|ngram-mod|none)\" >&2; exit 1; ;; \
esac; \
# Extra llama-server args (EXTRA_ARGS, see the header): word-split into \
# EXTRA_ARGS_ARR (default IFS = whitespace) so each token becomes one argv \
# entry; \"none\"/empty -> empty array, nothing appended. No shell quoting - \
# a quoted value would land as ONE token, so keep values plain. \
EXTRA_ARGS_ARR=(); \
if [ -n \"${EXTRA_ARGS}\" ] && [ \"${EXTRA_ARGS}\" != \"none\" ]; then \
  read -r -a EXTRA_ARGS_ARR <<< \"${EXTRA_ARGS}\"; \
fi; \
${LLAMA_CPP_DIR}/build/bin/llama-server \
  --model \"${MODEL_DIR}/${MODEL_FILE}\" \
  --alias \"${MODEL_ALIAS}\" \
  --host \"${HOST}\" \
  --port \"${PORT}\" \
  --ctx-size \"${CTX_SIZE}\" \
  --jinja \
  # Custom chat template only when enabled (CT non-empty). CT is a FILE \
  # PATH -> --chat-template-file (the inline --chat-template flag would \
  # treat the path as the literal template text: prompt degenerates to the \
  # path string and the model loops on it). \
  ${CT:+--chat-template-file \"${CT}\"} \
  --cache-prompt \
  # Speculation flags from SPEC_TYPE (empty when SPEC_TYPE=none). \
  ${SPEC} \
  # Multimodal projector (vision) only when enabled (see VISION_PATH above). \
  ${VISION_PATH:+--mmproj \"${VISION_PATH}\"} \
  --parallel 1 \
  --cont-batching \
  --metrics \
  --temp 0.1 \
  --top-p 0.95 \
  --min-p 0.05 \
  --repeat-penalty 1.0 \
  --flash-attn on \
  ${API_KEY:+--api-key \"$API_KEY\"} \
  # TurboQuant KV cache: this image's identity (the fork-only quantizations \
  # that let the 131k ctx fit in 24 GB), plus the post.txt sizing knobs. \
  --cache-type-k turbo5 \
  --cache-type-v turbo4 \
  --kv-unified \
  --fit off \
  --cache-ram 4096 \
  --main-gpu \"${GPU_ID}\" \
  --n-gpu-layers \"${N_GPU_LAYERS}\" \
  --threads \"${THREADS}\" \
  --batch-size \"${BATCH_SIZE}\" \
  --ubatch-size \"${UBATCH_SIZE}\" \
  # EXTRA_ARGS LAST: llama.cpp duplicate flags = last wins, so a group's \
  # tuning overrides the base flags above (ctx-size, sampling, flash-attn, \
  # cache types, spec params, ...) without a per-tuning image. The [@]+ \
  # guard expands to nothing for an empty array under set -u. \
  ${EXTRA_ARGS_ARR[@]+\"${EXTRA_ARGS_ARR[@]}\"} \
  # llama-server runs as a CHILD of this bash (PID 1), NOT via exec: the \
  # kernel drops every signal — SIGKILL included — sent from inside a PID \
  # namespace to a PID 1 with no handler installed, so a watchdog inside the \
  # container can never kill a handler-less init (verified in-container). \
  # This bash installs a SIGTERM trap (handler installed -> delivered): \
  # idle_watchdog's kill(1, SIGTERM) lands, bash kills the server (children \
  # take signals normally), and bash exiting tears down the PID namespace \
  # (the kernel reaps everything left). docker stop's SIGTERM takes the same \
  # graceful path. Exit code = the server's, so restart_policy sees reality. \
  & \
LLAMA_PID=$!; \
trap 'kill -TERM \"$LLAMA_PID\" 2>/dev/null; exit 0' TERM INT; \
wait \"$LLAMA_PID\"; \
exit $?""]
