# =============================================================================
# lmss_generic   (name spelling confirmed before push)
#
# The GENERIC model image: FROM boris271142/lmss:cuda128-v8 with NO baked
# models. At runtime everything is downloaded from HuggingFace via the fast
# `hf` xet path — the large main model AND the optional MTP draft and vision
# projector. It is the generic counterpart of lmss_jonathancoletti_qwen38_
# q6_mtp_vision (which bakes the 27B draft+vision into the image layers and
# always runs them); this image is model-agnostic, so it can serve ANY gguf
# whose auxiliary files (if it has any) live on the Hub.
#
#   baked (build time):  nothing model-related (the v3 runtime base only)
#   runtime download:    the main model, + optional draft (DRAFT_MODEL),
#                        + optional vision projector (VISION_MODEL)
#
# The v3 DRAFT_MODEL_URL / VISION_MODEL_URL mechanism (full URL + wget2,
# miserable speed) is GONE. The new DRAFT_MODEL / VISION_MODEL envs take a
# model REF instead:
#   * "none" (default)                      -> the feature is off
#   * "hf://<org>/<repo>/<file>"            -> that repo + file
#   * "<file>" (bare, no hf://)             -> the file in MODEL_REPO
# A set ref is downloaded with `hf download` (same tool, same xet fast path,
# same optional --token as the main model) into MODEL_DIR, then passed to
# llama-server as --model-draft / --mmproj. The "none" sentinel (never
# empty) matches the image's other feature conventions; the SaladCloud API
# rejects empty env values (minLength 1).
#
# SPECULATIVE DECODING — controlled by the NEW SPEC_TYPE env (three-way):
#   * SPEC_TYPE=draft-mtp (default)         -> --spec-type draft-mtp
#     --spec-draft-n-max ${SPEC_DRAFT_N_MAX}; the gguf's EMBEDDED MTP head is
#     used in place when DRAFT_MODEL is none, or the separate downloaded
#     draft is passed via --model-draft when DRAFT_MODEL is set.
#   * SPEC_TYPE=ngram-mod                    -> --spec-type ngram-mod
#     (n-match 24 / n-min 48 / n-max 64 — the v3 multistage fallback params):
#     n-gram self-speculation, no MTP head needed.
#   * SPEC_TYPE=none                         -> no speculative decoding at all.
# The explicit mode is what makes embedded-MTP ggufs work without a separate
# draft file (e.g. ATX-Swift Q5_K_M: draft-mtp + DRAFT_MODEL=none) — the old
# derived two-way (draft present -> draft-mtp, else ngram-mod) would have
# downgraded such a model to ngram-mod.
#
# CLAUDE TEMPLATE — same as the v5 qwen3.8 image: CLAUDE_TEMPLATE=none
# (default) serves the gguf's embedded template (or the static CHAT_TEMPLATE
# path if a group sets one); CLAUDE_TEMPLATE set (any value != "none") makes
# startup dump the chat template from the freshly downloaded gguf and apply
# the one-line Claude Code patch (mid-conversation system messages) via
# --chat-template-file.
#
# EXTRA ARGS — the EXTRA_ARGS env (default "none") is ONE STRING of extra
# llama-server args, whitespace-separated (e.g. "--threads-batch 8 --top-k 40
# --repeat-last-n 256 --reasoning-format none"). At startup it is word-split
# and APPENDED AT THE END of the llama-server argv. llama.cpp resolves
# duplicate flags LAST-WINS, so a group's EXTRA_ARGS can override the baked
# base flags (e.g. "--ctx-size 131072 --flash-attn off --temp 0.2") without a
# per-tuning image. Limitations: no shell quoting (every whitespace-separated
# token becomes one argv entry; llama.cpp flag values do not contain
# whitespace in practice); "none"/empty = off (the sentinel, never empty —
# the SaladCloud API rejects empty env values, minLength 1).
#
# MODEL SELECTION is 100% group-env driven: the deployer (deploy_generic.py)
# sets MODEL_REPO / MODEL_FILE / MODEL_ALIAS / CTX_SIZE per group. The image
# inherits the v3 base defaults (JonathanColetti Qwen3.8 noMTP-Q4_K_M) only
# so a bare `docker run` behaves exactly like v3.
#
# BUILD (context = REPO ROOT — claude_template.sh + version.sh are COPYed
# from docker/; nothing is downloaded at build time, no token):
#   docker build -f docker/Dockerfile.lmss_generic -t lmss_generic:dev .
#
# PUSH (NEW repo name = fresh Salad worker cache key; then pin the
# manifest-list digest in deploy_generic.py for the airtight re-pull lever):
#   docker tag  lmss_generic:dev boris271142/lmss_generic:cuda128-v1
#   docker push boris271142/lmss_generic:cuda128-v1
# =============================================================================

FROM boris271142/lmss:cuda128-v8@sha256:0386058c64d603430960c0b3d5ab03c2ad740f752d12ebd32b11dfc4ea31ebca

# Build id for /usr/local/bin/version.sh (same file the v3 image writes).
# The default lives in the RUN (shell ${ARG:-default}), NOT in the ARG line —
# a Dockerfile ARG default cannot carry unquoted spaces (it truncates to the
# first word, e.g. "lmss q6-mtp..." -> "lmss"). Override with
# --build-arg LMSS_BUILD_ID="..." for a per-push id.
ARG LMSS_BUILD_ID
RUN printf '%s\n' "${LMSS_BUILD_ID:-lmss generic-v9 (hf runtime download, claude-template, extra-args, idle_watchdog v2.2 [/.ssh presence guard] + bw_reporter + iputils-ping + llama-stats + apt kit [less nano iproute2 dnsutils jq], trapped-child supervisor, exec-form entry.sh CMD) 2026-10-09}" > /etc/llama-image-build

# --- Claude Code template: dump+patch script (repo-root build context) ------
# Zero dependencies (stdlib Python only); copied in and run at STARTUP, not at
# build time. COPYed from docker/ (hence the repo-root context).
COPY docker/claude_template.sh ${LLAMA_CPP_DIR}/claude_template.sh
# Entrypoint script (see the CMD at the end of this file) — extracted from the
# old inline `CMD ["/bin/bash","-lc","…"]` blob so a plain 3-token exec-form CMD
# cannot be mis-parsed by buildkit. Invoked as `bash /opt/llama.cpp/entry.sh`.
COPY docker/entry_generic.sh ${LLAMA_CPP_DIR}/entry.sh

# --- version.sh: overwrite the stale v3-baked copy --------------------------
# The v3 base ships an older version.sh (grep-based env dump, '>= 3 guards'
# fingerprint that misclassifies newer images). This one adds the full env
# table (every var the container reads: effective vs baked default, group-set
# marked, secrets redacted) and marker-based fingerprint classification. The
# exec bit is set on the source file, so COPY lands it executable.
COPY docker/version.sh /usr/local/bin/version.sh

# --- New control knobs --------------------------------------------------------
# DRAFT_MODEL: optional separate MTP draft model for --model-draft. "none"
# (default) = off (with SPEC_TYPE=draft-mtp the gguf's embedded MTP head is
# used in place). "hf://<org>/<repo>/<file>" or a bare "<file>" (against
# MODEL_REPO); downloaded at runtime with `hf` when missing.
ENV DRAFT_MODEL=none
# VISION_MODEL: optional multimodal projector (mmproj) GGUF for --mmproj.
# Same ref syntax as DRAFT_MODEL; "none" (default) = off (the projector costs
# ~1 GiB of VRAM, so it stays off unless the card has the headroom).
ENV VISION_MODEL=none
# SPEC_TYPE: the speculation mode — draft-mtp (default) | ngram-mod | none.
# See the SPECULATIVE DECODING section above.
ENV SPEC_TYPE=draft-mtp
# CLAUDE_TEMPLATE: "none" (default) -> the gguf's embedded template (or the
# static CHAT_TEMPLATE path if the group sets one). Any other value -> at
# startup the freshly downloaded gguf's chat template is dumped and the
# one-line Claude Code patch applied (see CLAUDE TEMPLATE section above); the
# patched file overrides CT.
ENV CLAUDE_TEMPLATE=none
# EXTRA_ARGS: one string of extra llama-server args, whitespace-separated;
# word-split at startup and appended LAST to the llama-server argv (llama.cpp
# duplicate flags = last wins, so these can override the baked base flags).
# "none" (default) = off. See the EXTRA ARGS header section.
ENV EXTRA_ARGS=none
# Idle/heartbeat self-shutdown (idle_watchdog.py from the v3 base, started by
# the CMD below): "none" (default) = OFF; idle -> kill after IDLE_TIMEOUT s of
# no chat traffic; heartbeat -> kill after HEARTBEAT_TIMEOUT s of no client
# pings. Arms on the group /ready endpoint (api_app :9999, the probe's own
# endpoint), holds IDLE_ARM_GRACE s, then kills = POST the Salad group /stop
# (SALAD_STOP_KEY = per-group scoped key from the deployer's --stop-key;
# "none" = skip) THEN SIGTERM — self-exit alone gets RESCHEDULED, not stopped.
ENV IDLE_SHUTDOWN=none \
    IDLE_TIMEOUT=600 \
    HEARTBEAT_TIMEOUT=600 \
    IDLE_GRACE=1800 \
    IDLE_ARM_GRACE=150 \
    READY_PORT=9999 \
    SALAD_STOP_KEY=none

# --- Runtime CMD -------------------------------------------------------------
# The v3 CMD with the wget2 DRAFT_MODEL_URL / VISION_MODEL_URL blocks replaced
# by `hf` downloads driven by the DRAFT_MODEL / VISION_MODEL refs, and the
# derived two-way spec-type replaced by the explicit three-way SPEC_TYPE.
# Everything else (socat, run_api.py, the CHAT_TEMPLATE + CLAUDE_TEMPLATE
# CT block, the full llama-server argv) is identical to v3/v5.

CMD ["/bin/bash", "-l", "/opt/llama.cpp/entry.sh"]
