# =============================================================================
# lmss_jonathancoletti_qwen38_q6_mtp_vision   (name spelling confirmed before push)
#
# A BAKED variant of boris271142/lmss:cuda128-v4 for the JonathanColetti
# Qwen3.8-27B quants. It extends the v3 runtime image (no recompile) and bakes
# the two SMALL auxiliary models into /models as image layers, so at runtime the
# group downloads ONLY the large main model from HuggingFace via the fast `hf`
# xet path. The draft + vision files that v3 used to fetch with wget2 (miserable
# speed) are already present in the image — nothing to download for them.
#
#   baked (build time):  /models/Qwen3.8-27B-Uncensored-draft-Q8_0.gguf  (~2.95 GiB)
#   baked (build time):  /models/mmproj-Qwen3.8-27B-Uncensored-F16.gguf  (~0.86 GiB)
#   runtime download:    only the main model (e.g. 15.4 GiB noMTP-Q4_K_M)
#
# DRAFT / speculative decoding — controlled by the NEW USE_DRAFT_MODEL env:
#   * USE_DRAFT_MODEL set (any value != "none")  -> the gguf has NO embedded MTP
#     head (e.g. the Q4_K_M noMTP build); the separate baked draft is passed to
#     llama-server via --model-draft.
#   * USE_DRAFT_MODEL unset / "none"             -> the gguf's MTP head is
#     embedded (e.g. Q6_K); `--spec-type draft-mtp` sets load_mtp and llama.cpp
#     uses the in-gguf nextn layers in place (no --model-draft).
#   BOTH cases always run:  --spec-type draft-mtp --spec-draft-n-max 5
#   This is an MTP image — there is NO ngram-mod fallback.
#
# VISION is ALWAYS on: --mmproj /models/mmproj-...-F16.gguf is passed
# unconditionally (that is why the image is named _vision).
#
# CLAUDE TEMPLATE — controlled by the NEW CLAUDE_TEMPLATE env:
#   * CLAUDE_TEMPLATE=none (default)             -> byte-identical to v4: the
#     gguf's embedded template is used (or the static CHAT_TEMPLATE path if a
#     group still sets one).
#   * CLAUDE_TEMPLATE set (any value != "none")  -> at startup, AFTER the main
#     model download, ${LLAMA_CPP_DIR}/claude_template.sh dumps the chat
#     template from the freshly downloaded gguf and replaces the one line that
#     raises on mid-conversation system messages (Claude Code sends them); the
#     patched file is passed via --chat-template-file and OVERRIDES CT, so the
#     single --chat-template-file flag below emits exactly once. A non-Qwen
#     gguf (no raise-marker) -> the script exits 0 silently and CT is left as
#     the CHAT_TEMPLATE block set it (embedded fallback).
#
# The v3 DRAFT_MODEL_URL / VISION_MODEL_URL (wget2) mechanism is GONE — its
# inherited ENVs are no longer read by this CMD; USE_DRAFT_MODEL + the baked
# files replace it. They are left inherited (unused) so the base image is
# otherwise undisturbed.
#
# BUILD (context = REPO ROOT — the Claude template script is COPYed from
# docker/, so build from the repo root):
#   docker build -f docker/Dockerfile.lmss_q6_mtp_vision \
#     -t lmss_jonathancoletti_qwen38_q6_mtp_vision:dev .
#   (base boris271142/lmss:cuda128-v4 is pulled if not local; the 27B repo is
#    public so the bake `hf download` needs no token)
#
# PUSH (NEW repo name = fresh Salad worker cache key; then pin the manifest-list
# digest in the deploy script for the airtight re-pull lever):
#   docker tag  ... boris271142/lmss_jonathancoletti_qwen38_q6_mtp_vision:<tag>
#   docker push boris271142/lmss_jonathancoletti_qwen38_q6_mtp_vision:<tag>
# =============================================================================

FROM boris271142/lmss:cuda128-v8@sha256:0386058c64d603430960c0b3d5ab03c2ad740f752d12ebd32b11dfc4ea31ebca

# --- Bake the two small auxiliary models into /models (build time) -----------
# The v3 runtime image already has the `hf` CLI (huggingface_hub 1.28.0) +
# HF_XET_HIGH_PERFORMANCE=1. The repo is public -> no HF token needed at build.
# These two files are the SAME draft/vision shared across every 27B quant whose
# draft is not merged into the main gguf (the user's "dumb way" to avoid the
# slow wget2 runtime fetch of ~1.2 GiB of small files).
ARG BAKE_REPO=JonathanColetti/Qwen3.8-27B-Uncensored-GGUF
ARG BAKE_DRAFT_FILE=Qwen3.8-27B-Uncensored-draft-Q8_0.gguf
ARG BAKE_VISION_FILE=mmproj-Qwen3.8-27B-Uncensored-F16.gguf
RUN set -eux; \
    hf download "${BAKE_REPO}" "${BAKE_DRAFT_FILE}" "${BAKE_VISION_FILE}" --local-dir /models; \
    test -s "/models/${BAKE_DRAFT_FILE}"; \
    test -s "/models/${BAKE_VISION_FILE}"

# Build id for /usr/local/bin/version.sh (same file the v3 image writes).
# The default lives in the RUN (shell ${ARG:-default}), NOT in the ARG line —
# a Dockerfile ARG default cannot carry unquoted spaces (it truncates to the
# first word, e.g. "lmss q6-mtp..." -> "lmss"). Override with
# --build-arg LMSS_BUILD_ID="..." for a per-push id.
ARG LMSS_BUILD_ID
RUN printf '%s\n' "${LMSS_BUILD_ID:-lmss q6-mtp-vision-v11 (baked draft+vision, claude-template, idle_watchdog v2.2 [/.ssh presence guard] + bw_reporter + iputils-ping + llama-stats + apt kit [less nano iproute2 dnsutils jq], trapped-child supervisor, exec-form entry.sh CMD) 2026-10-09}" > /etc/llama-image-build

# --- Claude Code template: dump+patch script (repo-root build context) ------
# Zero dependencies (stdlib Python only); copied in and run at STARTUP, not at
# build time. COPYed from docker/ (hence the repo-root context).
COPY docker/claude_template.sh ${LLAMA_CPP_DIR}/claude_template.sh
# Entrypoint script (see the CMD at the end of this file) — extracted from the
# old inline `CMD ["/bin/bash","-lc","…"]` blob so a plain 3-token exec-form CMD
# cannot be mis-parsed by buildkit. Invoked as `bash /opt/llama.cpp/entry.sh`.
COPY docker/entry_q6.sh ${LLAMA_CPP_DIR}/entry.sh

# --- version.sh: overwrite the stale v3-baked copy --------------------------
# The v3 base ships an older version.sh (grep-based env dump, '>= 3 guards'
# fingerprint that misclassifies v4). This one adds the full env table (every
# var the container reads: effective vs baked default, group-set marked,
# secrets redacted) and marker-based fingerprint classification. The exec bit
# is set on the source file, so COPY lands it executable.
COPY docker/version.sh /usr/local/bin/version.sh

# --- New control knob --------------------------------------------------------
# USE_DRAFT_MODEL: "none" (default) -> the gguf's MTP head is embedded and used
# in place (Q6_K-style). Any other value -> the separate baked draft file is
# passed via --model-draft (Q4_K_M-style, gguf has no MTP head). The SaladCloud
# group sets USE_DRAFT_MODEL=1 for the 27B noMTP-Q4_K_M build.
# "none" sentinel (never empty) to match the image's other feature conventions;
# the SaladCloud API rejects empty env values (minLength 1).
ENV USE_DRAFT_MODEL=none
# CLAUDE_TEMPLATE: "none" (default) -> v4 behavior (embedded template, or the
# static CHAT_TEMPLATE path if the group sets one). Any other value -> at
# startup the freshly downloaded gguf's chat template is dumped and the
# one-line Claude Code patch applied (see CLAUDE TEMPLATE section above); the
# patched file overrides CT.
ENV CLAUDE_TEMPLATE=none
# Idle/heartbeat self-shutdown (idle_watchdog.py from the v3 base, started by
# the CMD below): "none" (default) = OFF; idle -> kill after IDLE_TIMEOUT s of
# no chat traffic; heartbeat -> kill after HEARTBEAT_TIMEOUT s of no client
# pings. Arms on the group /ready endpoint (api_app :9999, the probe's own
# endpoint), holds IDLE_ARM_GRACE s, then kills = POST the Salad group /stop
# (SALAD_STOP_KEY = per-group scoped key from the deployer's --stop-key;
# "none" = skip) THEN SIGTERM — self-exit alone gets RESCHEDULED, not stopped.
ENV IDLE_SHUTDOWN=none \
    IDLE_TIMEOUT=600 \
    HEARTBEAT_TIMEOUT=600 \
    IDLE_GRACE=1800 \
    IDLE_ARM_GRACE=150 \
    READY_PORT=9999 \
    SALAD_STOP_KEY=none

# --- Runtime CMD -------------------------------------------------------------
# Faithful copy of the v3 CMD with exactly two changes: (1) no wget2 for the
# draft/vision (they are baked; only the main model hf-downloads), and (2) the
# draft is gated on USE_DRAFT_MODEL (adds --model-draft when set). Vision is
# always on. Everything else (socat, run_api.py, the full llama-server argv) is
# identical to v3.

CMD ["/bin/bash", "-l", "/opt/llama.cpp/entry.sh"]
